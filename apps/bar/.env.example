# Google Cloud Vision (recipe-photo OCR) + Vertex (LLM enrichment).
GCP_PROJECT_ID=
GCP_VISION_ENDPOINT=
GCP_VERTEX_LOCATION=
# Optionally disable
DISABLE_INGREDIENT_ENRICHMENT=
DISABLE_RECIPE_ENRICHMENT=

# Local dev: path to a service-account JSON key file.
GOOGLE_APPLICATION_CREDENTIALS=

# Production: inline credentials, used instead of the file when GCP_PRIVATE_KEY is set.
GCP_SERVICE_ACCOUNT_EMAIL=
GCP_PRIVATE_KEY=
