# Offline Dev Auth: alias Clerk to local stubs and run the app with no network
# (dev only — see docs/offline.md; ignored on Vercel).
#   1                  -> bootstrap a fresh sandbox org
#   <organisations.id> -> work against that existing local org
#                         (find via: SELECT id, name FROM organisations)
NEXT_PUBLIC_OFFLINE_DEV_AUTH=

NEXT_PUBLIC_BAR_URL=
NEXT_PUBLIC_LOUNGE_URL=

UPSTASH_KV_REST_API_URL=
UPSTASH_KV_REST_API_TOKEN=

