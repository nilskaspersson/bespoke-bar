{
	"$schema": "https://biomejs.dev/schemas/2.4.16/schema.json",
	"root": false,
	"extends": [
		"@bespoke/config/biome.base.json",
		"@bespoke/config/biome.web.json"
	],
	"files": {
		"includes": ["src/**", "next.config.ts"]
	},
	"linter": {
		"rules": {
			"style": {
				"noRestrictedImports": {
					"level": "error",
					"options": {
						"patterns": [
							{
								"group": ["../**"],
								"message": "Reach across directories through the `@/*` alias. Relative paths are for siblings that move together."
							}
						]
					}
				}
			}
		}
	}
}
