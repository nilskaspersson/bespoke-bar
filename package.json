{
	"name": "bespoke-bar",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "biome check",
		"test": "vitest run",
		"bench": "vitest bench",
		"ncu": "npx npm-check-updates --interactive",
		"ci": "biome ci && npm run icons:check && npm run test && npm run drizzle:migrate && npm run build && tsc --noEmit",
		"icons:build": "node --no-warnings src/libs/icons/build.ts",
		"icons:check": "node --no-warnings src/libs/icons/build.ts && git diff --exit-code src/libs/icons/sprite.svg src/libs/icons/types.ts",
		"drizzle:push": "drizzle-kit push",
		"drizzle:generate": "drizzle-kit generate",
		"drizzle:migrate": "drizzle-kit migrate",
		"drizzle:studio": "drizzle-kit studio"
	},
	"dependencies": {
		"@clerk/nextjs": "7.2.9",
		"@clerk/themes": "2.4.57",
		"@conform-to/react": "1.19.1",
		"@conform-to/zod": "1.19.1",
		"@google-cloud/vision": "5.3.5",
		"@google/genai": "1.51.0",
		"@lexical/history": "0.44.0",
		"@lexical/react": "0.44.0",
		"@lexical/utils": "0.44.0",
		"@neondatabase/serverless": "1.1.0",
		"@tanstack/react-query": "5.100.6",
		"@tanstack/react-table": "8.21.3",
		"@trpc/react-query": "11.17.0",
		"@upstash/ratelimit": "2.0.8",
		"@upstash/redis": "1.37.0",
		"babel-plugin-react-compiler": "1.0.0",
		"clsx": "2.1.1",
		"convert-units": "3.0.0-beta.7",
		"dotenv": "17.4.2",
		"downshift": "9.3.2",
		"drizzle-orm": "0.45.2",
		"drizzle-zod": "0.8.3",
		"google-auth-library": "10.6.2",
		"lexical": "0.44.0",
		"motion": "12.38.0",
		"nanoid": "5.1.9",
		"next": "16.2.4",
		"nuqs": "2.8.9",
		"pg": "8.20.0",
		"react": "19.2.5",
		"react-dom": "19.2.5",
		"sonner": "2.0.7",
		"zod": "4.4.1",
		"zustand": "5.0.12"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.13",
		"@iconify-json/lucide": "1.2.105",
		"@iconify/utils": "3.1.1",
		"@types/node": "25.6.0",
		"@types/pg": "8.20.0",
		"@types/react": "19.2.14",
		"@types/react-dom": "19.2.3",
		"@vitejs/plugin-react": "6.0.1",
		"drizzle-kit": "0.31.10",
		"jsdom": "29.1.1",
		"typescript": "6.0.3",
		"typescript-plugin-css-modules": "5.2.0",
		"vitest": "4.1.5"
	},
	"overrides": {
		"@clerk/nextjs": {
			"next": "$next"
		},
		"nuqs": {
			"next": "$next"
		}
	}
}
