{
	"name": "bespoke-bar",
	"version": "0.1.0",
	"private": true,
	"packageManager": "pnpm@11.25.0",
	"engines": {
		"node": "24.x"
	},
	"scripts": {
		"preinstall": "node scripts/only-pnpm.mjs",
		"dev": "turbo run dev",
		"build": "turbo run build",
		"lint": "turbo run lint",
		"test": "turbo run test",
		"check-types": "turbo run check-types",
		"deps": "pnpm dlx npm-check-updates --root --workspaces; CI=1 pnpm -C apps/mobile exec expo install --check || true",
		"deps:patch": "pnpm dlx npm-check-updates --root --workspaces --target patch -u --install never",
		"deps:minor": "pnpm dlx npm-check-updates --root --workspaces --target minor -i --install never",
		"deps:major": "pnpm dlx npm-check-updates --root --workspaces --target latest -i --install never",
		"deps:expo": "pnpm -C apps/mobile exec expo install --fix",
		"deps:verify": "pnpm install && turbo run lint check-types test bundle"
	},
	"devDependencies": {
		"turbo": "2.10.12"
	}
}
