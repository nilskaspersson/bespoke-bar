{
	"$schema": "https://biomejs.dev/schemas/2.0.0-beta.5/schema.json",
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": false
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"src/**",
			"next.config.ts",
			"drizzle.config.ts",
			"vitest.config.ts"
		]
	},
	"formatter": {
		"enabled": true,
		"useEditorconfig": true
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"suspicious": {
				"noDuplicateCustomProperties": "off"
			},
			"style": {
				"useComponentExportOnlyModules": "off"
			}
		},
		"domains": {
			"react": "all"
		}
	},
	"css": {
		"parser": {
			"cssModules": true
		}
	}
}
