{
	"$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
	"extends": [
		"@bespoke/config/biome.base.json",
		"@bespoke/config/biome.web.json"
	],
	"root": false,
	"files": {
		"includes": [
			"src/**",
			"!**/*.svg",
			"vitest.config.ts"
		]
	},
	"linter": {
		"rules": {
			"style": {
				"noRestrictedImports": {
					"level": "error",
					"options": {
						"patterns": [
							{
								"group": [
									"@bespoke/api",
									"@bespoke/api/**",
									"@bespoke/db",
									"@bespoke/db/**",
									"@clerk/**",
									"@google-cloud/**",
									"googleapis",
									"@google/genai",
									"@upstash/**",
									"pg",
									"@neondatabase/**",
									"drizzle-orm",
									"drizzle-orm/**",
									"stripe",
									"@conform-to/**"
								],
								"message": "packages/ui is shared web-DOM UI: no server/db/auth/LLM SDKs, no Drizzle, and no Conform. Lexical itself is allowed (the editor is a controlled text input), but form- and route-coupled Lexical consumers stay in apps/bar. It may use react, react-dom, next, lexical, and @bespoke/{schema,domain}."
							}
						]
					}
				}
			}
		}
	}
}
