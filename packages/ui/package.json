{
	"name": "@bespoke/ui",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"exports": {
		"./theme": "./src/theme/index.ts",
		"./theme/constants": "./src/theme/constants.ts",
		"./theme/ThemeScript": "./src/theme/ThemeScript.tsx",
		"./icons/types": "./src/icons/types.ts",
		"./icons/sprite.svg": "./src/icons/sprite.svg",
		"./hooks/useFormatter": "./src/hooks/useFormatter.tsx",
		"./hooks/*": "./src/hooks/*.ts",
		"./utils/*": "./src/utils/*.ts",
		"./stores/*": "./src/stores/*.ts",
		"./*/styles.module.css": "./src/*/styles.module.css",
		"./*": "./src/*/index.tsx"
	},
	"scripts": {
		"lint": "biome check",
		"test": "vitest run",
		"check-types": "tsc --noEmit",
		"icons:build": "node --no-warnings src/icons/build.ts",
		"icons:check": "node --no-warnings src/icons/build.ts && git diff --exit-code src/icons/sprite.svg src/icons/types.ts"
	},
	"dependencies": {
		"@bespoke/domain": "workspace:*",
		"@bespoke/schema": "workspace:*",
		"@lexical/react": "catalog:",
		"@lexical/selection": "catalog:",
		"@lexical/utils": "catalog:",
		"clsx": "catalog:",
		"downshift": "catalog:",
		"lexical": "catalog:",
		"motion": "catalog:",
		"next": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:",
		"sonner": "catalog:",
		"zod": "catalog:",
		"zustand": "catalog:"
	},
	"devDependencies": {
		"@bespoke/config": "workspace:*",
		"@biomejs/biome": "catalog:",
		"@iconify-json/lucide": "1.2.129",
		"@iconify/utils": "3.1.5",
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"jsdom": "catalog:",
		"typescript": "catalog:",
		"typescript-plugin-css-modules": "catalog:",
		"vitest": "catalog:"
	}
}
