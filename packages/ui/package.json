{
	"name": "@bespoke/ui",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"exports": {
		"./theme": "./src/theme/index.ts",
		"./theme/constants": "./src/theme/constants.ts",
		"./theme/ThemeScript": "./src/theme/ThemeScript.tsx",
		"./icons/types": "./src/icons/types.ts",
		"./icons/sprite.svg": "./src/icons/sprite.svg",
		"./hooks/useFormatter": "./src/hooks/useFormatter.tsx",
		"./hooks/*": "./src/hooks/*.ts",
		"./utils/*": "./src/utils/*.ts",
		"./stores/*": "./src/stores/*.ts",
		"./*/styles.module.css": "./src/*/styles.module.css",
		"./*": "./src/*/index.tsx"
	},
	"scripts": {
		"lint": "biome check",
		"test": "vitest run",
		"check-types": "tsc --noEmit",
		"icons:build": "node --no-warnings src/icons/build.ts",
		"icons:check": "node --no-warnings src/icons/build.ts && git diff --exit-code src/icons/sprite.svg src/icons/types.ts"
	},
	"dependencies": {
		"@bespoke/domain": "workspace:*",
		"@bespoke/schema": "workspace:*",
		"clsx": "2.1.1",
		"downshift": "9.3.2",
		"motion": "12.38.0",
		"next": "catalog:",
		"react": "19.2.7",
		"react-dom": "19.2.7",
		"sonner": "2.0.7",
		"zustand": "5.0.13"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.16",
		"@iconify-json/lucide": "1.2.108",
		"@iconify/utils": "3.1.3",
		"@types/node": "25.9.1",
		"@types/react": "19.2.15",
		"@types/react-dom": "19.2.3",
		"@vitejs/plugin-react": "6.0.2",
		"jsdom": "29.1.1",
		"typescript": "6.0.3",
		"typescript-plugin-css-modules": "5.2.0",
		"vitest": "4.1.7"
	}
}
