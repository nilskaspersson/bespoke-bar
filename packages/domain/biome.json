{
	"$schema": "https://biomejs.dev/schemas/2.4.16/schema.json",
	"root": true,
	"files": {
		"includes": ["src/**"]
	},
	"formatter": {
		"enabled": true,
		"useEditorconfig": true
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"style": {
				"noRestrictedImports": {
					"level": "error",
					"options": {
						"patterns": [
							{
								"group": [
									"react",
									"react-dom",
									"next",
									"next/**",
									"@clerk/**",
									"@google-cloud/**",
									"googleapis",
									"@google/genai",
									"@upstash/**",
									"pg",
									"@neondatabase/**",
									"@lexical/**"
								],
								"message": "packages/domain is PURE and React-Native-safe: pure logic only — no React, no Next, no DB driver, no server SDK. Server/UI code belongs in packages/db, packages/api, or packages/ui."
							}
						]
					}
				}
			}
		}
	}
}
