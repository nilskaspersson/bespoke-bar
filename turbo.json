{
	"$schema": "https://turborepo.dev/schema.json",
	"ui": "tui",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"],
			"env": [
				"DATABASE_*",
				"POSTGRES_*",
				"PG*",
				"EDGE_CONFIG",
				"UPSTASH_*",
				"CLERK_*",
				"STRIPE_*"
			]
		},
		"lint": {
			"dependsOn": ["^lint"]
		},
		"check-types": {
			"dependsOn": ["^check-types"]
		},
		"test": {},
		"dev": {
			"cache": false,
			"persistent": true
		}
	}
}
